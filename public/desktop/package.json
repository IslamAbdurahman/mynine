{
  "name": "mynine-exam-browser",
  "version": "1.0.0",
  "description": "Mynine Official Secure Exam Desktop Browser",
  "main": "main.js",
  "author": "Mynine Academy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "uz.mynine.exam",
    "productName": "Mynine Exam Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mynine Exam Browser"
    },
    "portable": {
      "artifactName": "Mynine-Exam-Portable-${version}.exe"
    }
  }
}
